== hover rules
@(hover: hover) header nav a.navlink:hover::after { transform: scaleX(1); transform-origin: left bottom; }
@(hover: hover) .dropdown:hover:not(.open) .plusPill { transform: translateZ(0px); transition: transform 0.12s ease-out; }
@(hover: hover) .slide:hover:not(.active) .plusPill { transform: translateZ(0px); transition: transform 0.12s ease-out; }
@(hover: hover) .teamMember .name:hover { opacity: 1; transition: opacity 0.12s ease-in-out; }
@(hover: hover) .teamMember .overlayCont .portraitCont .linkedin:hover { background-color: var(--color-lime); transition: background-color 0.12s ease-in-out, width 0.12s ease-in-out; width: 111px; }
@(hover: hover) .teamMember .overlayCont .portraitCont .linkedin:hover .logo { opacity: 1; transition: opacity 0.12s ease-in-out 0.12s; }
@(hover: hover) .teamMember .overlayCont .portraitCont .linkedin:hover .arrow { transform: scaleX(1) translate3d(0px, -50%, 0px); transition: transform 0.12s ease-in-out; }
@screen and (min-width: 769px) and (hover: hover) .ctaSection .buttons a.signup:hover { background-color: var(--color-earth); color: var(--color-oat); width: 202px; }
@screen and (min-width: 769px) and (hover: hover) .ctaSection .buttons a.linkedin:hover { background-color: var(--color-earth); color: var(--color-oat); width: 189px; }