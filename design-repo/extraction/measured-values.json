      ]
    },
    {
      "id": "story-total-hardcoded",
      "claim": "Story reveal total is a hardcoded 60 (21+8+10+9+8 words + 4 logos).",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/lib/content.js",
          "lines": "29",
          "quote": "total: 60"
        },
        {
          "path": "CLONE_SPEC.md",
          "lines": "277",
          "quote": "Total `c = 60`"
        }
      ]
    },
    {
      "id": "legal-whole-article-decomposed",
      "claim": "Before this revision template.legal-prose was header + one content.legal-prose section holding the whole article. Measured on the original: article [0,0,1440x3476.4] in a 4423px document = 79% of the page, above the 60% wrapper-gate error threshold. It is now content.legal-header + 8 heading-bounded content.legal-section units (largest 1150.4px = 26%).",
      "evidenceLevel": "measured",
      "evidence": [
        {
          "path": ".playwright-mcp/orig-pp-1440.txt.n",
          "lines": "27",
          "quote": "article [0,0,1440x3476.4]"
        },
        {
          "path": "CLONE_SPEC.md",
          "lines": "498",
          "quote": "Document height 4423 at 1440x900"
        }
      ]
    }
  ],
