        },
        {
          "path": "src/components/OurWork.jsx",
          "lines": "238",
          "quote": "offset.current -= 0.5"
        }
      ]
    },
    {
      "id": "no-reduced-motion",
      "claim": "Neither the source nor the original CSS has any prefers-reduced-motion rule; reducedMotionFallback values are prescriptive.",
      "evidenceLevel": "source-code (grep count 0)",
      "evidence": []
    },
    {
      "id": "no-shadows-no-dark-mode",
      "claim": "0 box-shadow and 0 prefers-color-scheme declarations in the original CSS and src/index.css: elevation is z-index only; one light theme.",
      "evidenceLevel": "source-code (grep count 0)",
      "evidence": []
    },
    {
      "id": "colour-histogram",
      "claim": "Colour usage counts (concatenated original CSS): earth 15, oat 14, coral 9, lime 7, white 6, earth-light 3, 1 each for coral-light, lime-dark, footer-text, footer-credits, black, scrim, nav-hover.",
      "evidenceLevel": "measured (grep histogram)",
      "evidence": [
        {
          "path": "The Equator Company_files/entry.DkmCBGCE.css",
          "lines": "1",
          "quote": "--color-oat:#fcf8f0"
        }
      ]
    },
    {
      "id": "font-licence",
      "claim": "National 2 is a commercial Klim typeface: licence-required.",
      "evidenceLevel": "spec",
      "evidence": [
        {
          "path": "CLONE_SPEC.md",
          "lines": "78-83",
          "quote": "Klim Type Foundry"
        }
      ]
    },
    {
      "id": "not-found-unmeasured",
      "claim": "NotFound.jsx was added after QA and never measured against the original's Nuxt 404; no 404 capture exists in .playwright-mcp.",
      "evidenceLevel": "inferred-unmeasured",
      "evidence": [
        {
          "path": "src/pages/NotFound.jsx",
          "lines": "3",
          "quote": "live: unknown routes render Nuxt's default 404"
        }
      ]
    },
    {
      "id": "a11y-snapshot",
      "claim": "An accessibility snapshot shows capability cards and team names as generic[cursor=pointer] nodes (no button role). The snapshot file does not record which origin (original or clone) it captured.",
      "evidenceLevel": "measured (origin unrecorded)",
      "evidence": [
        {
          "path": ".playwright-mcp/page-2026-10-20T07-51-14-303Z.yml",
          "lines": "133-134",
          "quote": "generic [ref=e169] [cursor=pointer]"
