{
  "ledgerVersion": "2.0.0",
  "description": "Citations to build-time evidence outside this package (the clone source, CLONE_SPEC.md, the saved original CSS, Playwright QA dumps). Paths are relative to the design-repo's parent folder. verify_all.py checks every {path, lines, quote} object in the repo: range within file length and quote present in the cited lines. When the sibling source tree is absent (standalone copy), these degrade to warnings.",
  "sourceProject": {
    "name": "equator clone",
    "framework": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "vite": "^5.4.10",
      "tailwindcss": "^3.4.14",
      "lenis": "^1.3.27",
      "@lottiefiles/dotlottie-web": "^0.81.0"
    },
    "originalSite": "https://equatorcompany.com/ (Nuxt 3 / Vue 3; Locomotive Scroll v5 over Lenis 1.1.9; dotlottie-web 0.54.1; vue3-carousel; marquee3k)",
    "markerFiles": [
      "src/App.jsx",
      "CLONE_SPEC.md",
      "package.json"
    ],
    "isGitRepo": true
  },
  "entries": [
    {
      "id": "framework-versions",
      "claim": "Clone stack versions taken from package.json.",
      "evidenceLevel": "source-code",
