        }
      ]
    },
    {
      "id": "routes",
      "claim": "Three render paths: '/', '/privacy-policy', and a catch-all NotFound.",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/App.jsx",
          "lines": "15-17",
          "quote": "if (path === '/') return <Home"
        }
      ]
    },
    {
      "id": "home-order",
      "claim": "Home section order: splash, header, title, story, values, capabilities, work, team, CTA, footer, subfooter.",
      "evidenceLevel": "measured",
      "evidence": [
        {
          "path": "src/pages/Home.jsx",
          "lines": "106-129",
          "quote": "<Splash logoSmall={small} />"
        },
        {
          "path": ".playwright-mcp/orig-1440.txt.n",
          "lines": "13",
          "quote": "section.splash"
        },
        {
          "path": ".playwright-mcp/orig-1440.txt.n",
          "lines": "624",
          "quote": "section.ctaSection"
        }
      ]
    },
    {
      "id": "values-initial-opacity",
      "claim": "Values panels 1-4 start at opacity 0 and are driven by an IO (rootMargin 100%) plus scroll progress, snapped to 0/1 on exit. QA-measured parity. CLONE_SPEC 7.2 itself notes the original's refs start at 0 but recommends initialising to 1 'for the same visual result'; the clone rejected that recommendation in favour of exact parity.",
      "evidenceLevel": "measured",
      "evidence": [
        {
          "path": ".playwright-mcp/orig-1440.txt.n",
          "lines": "85",
          "quote": "op:0"
        },
        {
          "path": "src/index.css",
          "lines": "287-292",
          "quote": "var(--hide1-opacity, 0)"
        },
        {
          "path": "src/components/Values.jsx",
          "lines": "64-83",
          "quote": "rootMargin: '100% 100% 100% 100%'"
        },
        {
          "path": "CLONE_SPEC.md",
          "lines": "308",
          "quote": "**Initialise to 1**"
        }
      ]
    },
    {
      "id": "carousel-clamp",
      "claim": "Carousel translate is clamped at trackWidth - viewportWidth (-1890px at 1440 after the 3rd 'next'); CLONE_SPEC 9's -index*(slideW+20) formula is unclamped.",
      "evidenceLevel": "measured",
      "evidence": [
        {
          "path": ".playwright-mcp/orig-state-1440.txt.n",
          "lines": "44-47",
          "quote": "matrix(1, 0, 0, 1, -1890, 0)"
        },
        {
          "path": "src/components/OurWork.jsx",
          "lines": "77-80",
          "quote": "clamp(translate, 0, maxTranslate)"
        },
        {
          "path": "CLONE_SPEC.md",
          "lines": "360",
          "quote": "translateX(-index*(slideW+20)px)"
        }
      ]
    },
    {
      "id": "anchor-scroll",
      "claim": "Anchor scroll is frame-based (t += 1/60), duration clamp(distance/2000, 0.1, 0.8)s, easeOutSine.",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/lib/scroll.js",
          "lines": "103-118",
          "quote": "t += 1 / 60"
        },
        {
          "path": "src/lib/scroll.js",
          "lines": "106",
          "quote": "Math.max(0.1, Math.min(Math.abs(cur - target) / 2000, 0.8))"
        },
        {
          "path": "src/lib/scroll.js",
          "lines": "112",
          "quote": "Math.sin((p * Math.PI) / 2)"
        }
      ]
    },
    {
      "id": "lottie-cadence",
      "claim": "Lottie players use useFrameInterpolation:false for the original's 30fps whole-frame cadence.",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/components/LottiePlayer.jsx",
          "lines": "20-22",
          "quote": "useFrameInterpolation: false"
        }
      ]
    },
    {
      "id": "lazy-fade",
      "claim": "Lazy image fade is opacity .16s ease-in-out.",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/index.css",
          "lines": "430",
          "quote": "transition: opacity .16s ease-in-out 0s"
        },
        {
          "path": "The Equator Company_files/index.Bz9B3sVc.css",
          "lines": "1",
          "quote": "transition:opacity .16s"
        }
      ]
    },
    {
      "id": "ui-timings",
      "claim": "Most hover/UI transitions 0.12s; mobile menu 0.2s; carousel 300ms ease-out; marquee 0.5px/frame leftward.",
      "evidenceLevel": "source-code",
      "evidence": [
        {
          "path": "src/index.css",
          "lines": "354",
          "quote": "transition: height .12s ease-in-out 0s"
        },
        {
          "path": "src/index.css",
