{
  "$description": "Page margin and section rhythm. --margin-page is the only spacing custom property; section paddings are literal px in the CSS.",
  "$extensions": {
    "evidence": [
      {
        "path": "src/index.css",
        "lines": "26-43",
        "quote": "--margin-page: 50px;"
      },
      {
        "path": "src/index.css",
        "lines": "44-46",
        "quote": "--margin-page: 30px;"
      },
      {
        "path": "src/index.css",
        "lines": "47-57",
        "quote": "--margin-page: 20px;"
      },
      {
        "path": "src/index.css",
        "lines": "337-339",
        "quote": "padding: 150px var(--margin-page)"
      },
      {
        "path": "src/index.css",
        "lines": "343-346",
        "quote": "padding: 75px var(--margin-page)"
      }
    ]
  },
  "space": {
