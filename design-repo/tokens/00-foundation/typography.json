        "path": "The Equator Company_files/entry.DkmCBGCE.css",
        "lines": "1",
        "quote": "--font-size-headline1:6rem"
      },
      {
        "path": "src/index.css",
        "lines": "26-43",
        "quote": "--font-size-headline1: 6rem"
