      {
        "path": "CLONE_SPEC.md",
        "lines": "62-76",
        "quote": "Text role classes (computed at 1440 / 390)"
      },
      {
        "path": "src/index.css",
        "lines": "36",
        "quote": "--font-line-body-s: 1.18"
      }
    ]
  },
  "font": {
